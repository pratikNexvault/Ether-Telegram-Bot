# ==========================================
# ETHER CUSTOM TELEGRAM GROUP BOT CONFIG
# ==========================================

# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Bot Owner Username (without @)
OWNER_USERNAME=your_telegram_username

# Optional Telegram Numeric ID for Owner
OWNER_ID=0

# If true, ONLY owner can execute commands
OWNER_ONLY_MODE=false

# Spam System Parameters
MAX_SPAM_COUNT=20
SPAM_DELAY=1.0

# Raid System Parameters
RAID_COOLDOWN=3.0

# GEMINI_API_KEY: For AI capabilities if enabled
GEMINI_API_KEY=
APP_URL=
